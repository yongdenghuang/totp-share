# /etc/totp-share/env —— 权限 600，属主 root。请勿提交到 git。
# FERNET_KEY 丢失后，数据库里的 TOTP 密钥将无法解密。

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# 前面有反向代理或 Cloudflare 隧道时请保持 127.0.0.1，不要对公网监听
BIND_ADDR=127.0.0.1
PORT=8765
DATABASE_PATH=/opt/totp-share/data/totp.db
